// Resource script for AS Auto Switcher
// Embeds Windows application icon and Version metadata into compiled PE header

1 ICON "logo/app.ico"

1 VERSIONINFO
FILEVERSION 1,0,3,3
PRODUCTVERSION 1,0,3,3
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Antigravity Open Source"
            VALUE "FileDescription", "AS Auto Switcher"
            VALUE "FileVersion", "1.0.3.3"
            VALUE "InternalName", "AS_Auto_Switcher"
            VALUE "LegalCopyright", "Copyright (C) 2026"
            VALUE "OriginalFilename", "AS_Auto_Switcher.exe"
            VALUE "ProductName", "AS Auto Switcher"
            VALUE "ProductVersion", "1.0.3.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
