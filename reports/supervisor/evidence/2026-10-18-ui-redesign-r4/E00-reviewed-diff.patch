+			}
+		}
+	}`)
+
+	tempDir := t.TempDir()
+	cachePath := filepath.Join(tempDir, "legacy_cache.json")
+	if err := os.WriteFile(cachePath, legacyJSON, 0644); err != nil {
+		t.Fatalf("failed to write legacy cache: %v", err)
+	}
+
+	cache := NewQuotaCache(cachePath)
