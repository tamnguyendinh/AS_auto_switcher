+	if loaded.Gemini.FiveHourFraction != -1 || loaded.Gemini.WeeklyFraction != -1 {
+		t.Errorf("expected missing Gemini cycle fractions == -1, got 5h=%f, week=%f", loaded.Gemini.FiveHourFraction, loaded.Gemini.WeeklyFraction)
