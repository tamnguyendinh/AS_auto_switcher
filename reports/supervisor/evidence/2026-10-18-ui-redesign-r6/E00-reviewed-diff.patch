+//go:build ignore
+
+// Coder R6 independent acceptance probe verifying closure of F1 (both cycles zero without raw/reset)
+// and absolute preservation of F2, F3, F4, F5, F6.
+// Run from repo root: go run reports/coder/evidence/2026-10-18-ui-redesign-f1-f6/coder_probe_r6.go
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
